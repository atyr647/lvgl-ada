project Lvgl_Ada is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "lvgl/src/**");

   --  Excluded: every vendored third-party codec/rendering library under
   --  lvgl/src/libs (libpng, freetype, thorvg, vg_lite_driver, ...) except
   --  tjpgd (small JPEG decoder, for camera snapshots) and tiny_ttf's
   --  headers (TrueType fonts at any size, for high-density phones), and
   --  the vg_lite debug shim. None are enabled in the committed
   --  lv_conf.h (this binding needs none of them), and two problems rule
   --  out just leaving them in Source_Dirs anyway: several GPU-series
   --  variants under vg_lite_driver ship same-named files GPR's flat
   --  per-project source namespace can't host at once, and thorvg bundles
   --  an MSVC-only stdint.h/inttypes.h shim (rapidjson/msinttypes) that
   --  shadows the real ones once its directory is on GPR's (automatic,
   --  per-source-dir) C include path, breaking unrelated widgets that
   --  merely happen to be compiled after it.
   for Excluded_Source_Dirs use
     ("lvgl/src/libs/FT800-FT813/**",
      "lvgl/src/libs/barcode/**",
      "lvgl/src/libs/bin_decoder/**",
      "lvgl/src/libs/bmp/**",
      "lvgl/src/libs/ffmpeg/**",
      "lvgl/src/libs/freetype/**",
      "lvgl/src/libs/frogfs/**",
      "lvgl/src/libs/fsdrv/**",
      "lvgl/src/libs/gif/**",
      "lvgl/src/libs/gltf/**",
      "lvgl/src/libs/gstreamer/**",
      "lvgl/src/libs/libjpeg_turbo/**",
      "lvgl/src/libs/libpng/**",
      "lvgl/src/libs/libwebp/**",
      "lvgl/src/libs/lodepng/**",
      "lvgl/src/libs/lz4/**",
      "lvgl/src/libs/nanovg/**",
      "lvgl/src/libs/qrcode/**",
      "lvgl/src/libs/rle/**",
      "lvgl/src/libs/rlottie/**",
      "lvgl/src/libs/thorvg/**",
      "lvgl/src/libs/vg_lite_driver/**",
      "lvgl/src/debugging/vg_lite_tvg/**");

   --  Separate build folders per target, so a desktop build and an
   --  Android cross build (-XLVGL_ADA_BUILD=android) never mix objects.
   type Build_Type is ("native", "android");
   Build : Build_Type := external ("LVGL_ADA_BUILD", "native");
   case Build is
      when "native" =>
         for Object_Dir use "obj";
         for Library_Dir use "lib";
      when "android" =>
         for Object_Dir use "obj-android";
         for Library_Dir use "lib-android";
   end case;
   for Library_Name use "lvgl_ada";
   for Create_Missing_Dirs use "True";

   type Library_Type_Type is ("static", "relocatable", "static-pic");
   Library_Type : Library_Type_Type := external ("LIBRARY_TYPE", "static");
   for Library_Kind use Library_Type;

   --  LVGL's own SDL2 driver (Lv.Sdl) needs SDL2 at link time even for
   --  programs that never call into it, since it is compiled into every
   --  build of this static library (LV_USE_SDL is set in the committed
   --  lv_conf.h, not per-program). A static library's .gpr cannot inject
   --  linker flags into whatever links against it the way a relocatable
   --  one can (gprbuild rejects Library_Options / package Linker here
   --  for a static Library_Kind) -- programs that with this project must
   --  add ("-lSDL2", "-lm") to their own package Linker, same as any
   --  other C dependency of a static Ada library.

   package Compiler is
      --  SDL_INCLUDE_DIR: where SDL2/SDL.h lives -- the system's by
      --  default, a cross-built SDL's for Android.
      for Switches ("C") use
        ("-DLV_CONF_INCLUDE_SIMPLE",
         "-I" & Lvgl_Ada'Project_Dir,
         "-I" & Lvgl_Ada'Project_Dir & "lvgl",
         "-I" & external ("SDL_INCLUDE_DIR", "/usr/include"),
         --  One extra flag for cross builds, e.g. -include a compatibility
         --  header (Android 8 lacks aligned_alloc).
         external ("LVGL_EXTRA_CFLAG", "-DLVGL_ADA=1"),
         "-O2", "-g");
      for Switches ("Ada") use ("-gnat2012", "-gnatwa", "-g");
   end Compiler;

end Lvgl_Ada;
